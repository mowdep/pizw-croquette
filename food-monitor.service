[Unit]
Description=Moniteur de niveau de croquettes
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/pizw-croquette
EnvironmentFile=/opt/pizw-croquette/.env
ExecStart=/opt/pizw-croquette/.venv/bin/python food_monitor.py
Restart=always
RestartSec=5

# Utilisateur dédié, membre du groupe gpio (accès /dev/gpiomem sans root).
User=croquette
Group=gpio

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/pizw-croquette

[Install]
WantedBy=multi-user.target
